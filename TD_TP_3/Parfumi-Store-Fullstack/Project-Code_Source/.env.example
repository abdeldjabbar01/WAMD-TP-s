# Optional: leave blank to use the default local API URL.
VITE_API_URL=http://localhost:5000/api

# Optional Auth0 SPA application settings (Authorization Code + PKCE).
# Configure http://localhost:5173 as an Allowed Callback URL and Allowed Logout URL.
VITE_AUTH0_DOMAIN=your-tenant.region.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_application_client_id
VITE_AUTH0_AUDIENCE=your_auth0_api_identifier
# Auth0 Google social connection must be enabled in your Auth0 dashboard
